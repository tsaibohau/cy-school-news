    "dates":{"type":"object","additionalProperties":false,"required":["published_date","deadline_date","event_dates","application_start","application_end","effective_until","exam_date","registration_start","registration_end","date_spans"],"properties":{"published_date":{"type":["string","null"],"format":"date"},"deadline_date":{"type":["string","null"],"format":"date"},"event_dates":{"type":"array","items":{"type":"object","required":["date"],"additionalProperties":false,"properties":{"date":{"type":"string","format":"date"},"kind":{"type":"string"},"precision":{"enum":["day","month","year"]}}}},"application_start":{"type":["string","null"],"format":"date"},"application_end":{"type":["string","null"],"format":"date"},"effective_until":{"type":["string","null"],"format":"date"},"exam_date":{"type":["string","null"],"format":"date"},"registration_start":{"type":["string","null"],"format":"date"},"registration_end":{"type":["string","null"],"format":"date"},"date_spans":{"type":"array","items":{"type":"object","required":["raw_text","precision"],"additionalProperties":false,"properties":{"raw_text":{"type":"string"},"precision":{"enum":["day","month","year","uncertain"]},"start_date":{"type":["string","null"],"format":"date"},"end_date":{"type":["string","null"],"format":"date"},"meaning":{"type":"string"}}}}}},
    "affected_audience":{"type":"array","uniqueItems":true,"items":{"enum":["grade_1","grade_2","grade_3","teacher","all_students","uncertain"]}},
    "teacher_related":{"enum":[true,false,"uncertain"]},
