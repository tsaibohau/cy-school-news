  "properties": {
    "announcement_id": {"type":"string","minLength":1},
    "source_status": {"type":"object","required":["canonical_status","page_available","attachments_checked"],"additionalProperties":false,"properties":{"canonical_status":{"enum":["available","missing_confirmed","temporarily_unreachable","partial","unknown"]},"page_available":{"type":"boolean"},"attachments_checked":{"type":"boolean"},"unparsed_attachment_count":{"type":"integer","minimum":0}}},
