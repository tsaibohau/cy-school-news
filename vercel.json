{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node tools/build-staging.js",
  "outputDirectory": "dist-staging",
  "cleanUrls": false,
  "functions": {
    "api/mock-admin.js": {
      "maxDuration": 10,
      "includeFiles": "{docs/data/announcements.json,docs/data/archive.json}"
    },
    "api/admin-announcement-export.js": {
      "maxDuration": 60,
      "includeFiles": "{tools/staging/account-config.js,docs/data/announcements.json,docs/data/archive.json}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ]
}
